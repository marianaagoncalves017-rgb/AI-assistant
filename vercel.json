{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "src": "/Logo_ETPC.png",
      "dest": "/Logo_ETPC.png"
    },
    {
      "src": "/conhecimento.json",
      "dest": "/conhecimento.json"
    },
    {
      "src": "/api/script.js",
      "dest": "/api/script.js"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
